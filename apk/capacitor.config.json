{
  "appId": "io.github.miguelarc0401.liturgicum",
  "appName": "Liturgicum",
  "webDir": "../app",
  "backgroundColor": "#fbf7ef",
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
